# 5G/6G NetSlice Configuration Environment Variables
# Copy this file to .env before starting:
#   cp .env.example .env

# Optional: Google Gemini API Key for the AI Network Assistant Chatbot
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Frontend API URL (leave blank when running with Docker or Nginx reverse proxy)
# For standalone local development, defaults to: http://localhost:8000
VITE_API_URL=
